library(edge_cases) {
  cell(CASE_NORMAL_MUX2) {
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(S) { direction : input; }
    pin(Y) { direction : output; function : "(!S&A)|(S&B)"; }
  }

  cell(CASE_INVERTED_MUX2) {
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(S) { direction : input; }
    pin(Y) { direction : output; function : "(!S&!A)|(S&!B)"; }
  }

  cell(CASE_MUX4) {
    pin(S0) { direction : input; }
    pin(S1) { direction : input; }
    pin(D0) { direction : input; }
    pin(D1) { direction : input; }
    pin(D2) { direction : input; }
    pin(D3) { direction : input; }
    pin(Y) {
      direction : output;
      function : "(!S0&!S1&D0)|(S0&!S1&D1)|(!S0&S1&D2)|(S0&S1&D3)";
    }
  }

  cell(CASE_MUX8) {
    pin(S0) { direction : input; }
    pin(S1) { direction : input; }
    pin(S2) { direction : input; }
    pin(D0) { direction : input; }
    pin(D1) { direction : input; }
    pin(D2) { direction : input; }
    pin(D3) { direction : input; }
    pin(D4) { direction : input; }
    pin(D5) { direction : input; }
    pin(D6) { direction : input; }
    pin(D7) { direction : input; }
    pin(Y) {
      direction : output;
      function : "(!S0&!S1&!S2&D0)|(S0&!S1&!S2&D1)|(!S0&S1&!S2&D2)|(S0&S1&!S2&D3)|(!S0&!S1&S2&D4)|(S0&!S1&S2&D5)|(!S0&S1&S2&D6)|(S0&S1&S2&D7)";
    }
  }

  cell(CASE_GATED) {
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(S) { direction : input; }
    pin(EN) { direction : input; }
    pin(Y) { direction : output; function : "EN&((!S&A)|(S&B))"; }
  }

  cell(CASE_MIXED_POLARITY) {
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(S) { direction : input; }
    pin(Y) { direction : output; function : "(!S&!A)|(S&B)"; }
  }

  cell(CASE_DUMMY_INPUT) {
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(S) { direction : input; }
    pin(X) { direction : input; }
    pin(Y) {
      direction : output;
      function : "((!S&A)|(S&B))|(X&!X)";
    }
  }

  cell(CASE_REPEATED_DATA) {
    pin(A) { direction : input; }
    pin(S) { direction : input; }
    pin(Y) { direction : output; function : "(!S&A)|(S&A)"; }
  }

  cell(CASE_MALFORMED) {
    pin(Y) { direction : output; function : "A &"; }
  }

  cell(CASE_MISSING_FUNCTION) {
    pin(Y) { direction : output; }
  }

  cell(CASE_CONSTANT) {
    pin(Y) { direction : output; function : "1"; }
  }

  cell(CASE_SEQUENTIAL) {
    ff(IQ, IQN) { next_state : "D"; }
    pin(Q) { direction : output; function : D; }
  }

  cell(CASE_TRI_STATE) {
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(S) { direction : input; }
    pin(Y) {
      direction : output;
      three_state : "OE";
      function : "(!S&A)|(S&B)";
    }
  }

  cell(CASE_NESTED_GROUPS) {
    test_cell(test) {
      pin(FAKE_TEST) { direction : output; function : "(!S&A)|(S&B)"; }
    }
    pg_pin(VDD) {
      pin(FAKE_POWER) { direction : output; function : "(!S&A)|(S&B)"; }
    }
    pin(Y) { direction : output; function : A; }
  }

  cell("CASE_QUOTED)") {
    pin("Y)") { direction : output; function : A; }
  }

  cell(CASE_TWO_OUTPUTS) {
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(S) { direction : input; }
    pin(Y) { direction : output; function : "(!S&A)|(S&B)"; }
    pin(YN) { direction : output; function : "!((!S&A)|(S&B))"; }
  }
}
