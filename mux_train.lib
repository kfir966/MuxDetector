      clocked_on : "CK" ;
    }
    pin (D) { direction : input ; capacitance : 0.001 ; nextstate_type : data ; }
    pin (SI) { direction : input ; capacitance : 0.001 ; nextstate_type : scan_in ; }
    pin (SE) { direction : input ; capacitance : 0.001 ; nextstate_type : scan_enable ; }
    pin (CK) { direction : input ; capacitance : 0.001 ; clock : true ; }
    pin (Q) {
      direction : output ;
      function : "IQ" ;
      timing () { related_pin : "CK" ; timing_type : rising_edge ; }
    }
    test_cell () {
      ff (IQ, IQN) { next_state : "D" ; clocked_on : "CK" ; }
      pin (D) { direction : input ; }
      pin (SI) { direction : input ; signal_type : test_scan_in ; }
      pin (SE) { direction : input ; signal_type : test_scan_enable ; }
      pin (CK) { direction : input ; }
      pin (Q) { direction : output ; function : "IQ" ; signal_type : test_scan_out ; }
    }
