/* Training library: share with the candidate
 * Synthetic library for the functional MUX-detection take-home.
 * Cell and pin names are intentionally uninformative. Timing values are dummies.
 */
library (mux_train) {
  delay_model : table_lookup ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  current_unit : "1mA" ;
  capacitive_load_unit (1, pf) ;
  pulling_resistance_unit : "1kohm" ;
  leakage_power_unit : "1nW" ;
  nom_process : 1.0 ;
  nom_temperature : 25.0 ;
  nom_voltage : 0.8 ;
  operating_conditions (tt_0p8v_25c) {
    process : 1.0 ;
    temperature : 25 ;
    voltage : 0.8 ;
  }
  default_operating_conditions : tt_0p8v_25c ;
  lu_table_template (delay_2x2) {
    variable_1 : input_net_transition ;
    variable_2 : total_output_net_capacitance ;
    index_1 ("0.01, 0.1") ;
    index_2 ("0.001, 0.01") ;
  }
  cell (XQ_701) {
    area : 1.0 ;
    pg_pin (VDD) { voltage_name : VDD ; pg_type : primary_power ; }
    pg_pin (VSS) { voltage_name : VSS ; pg_type : primary_ground ; }
    pin (I0) {
      direction : input ;
      capacitance : 0.0011 ;
    }
    pin (I1) {
      direction : input ;
      capacitance : 0.0011 ;
    }
    pin (S) {
      direction : input ;
      capacitance : 0.0011 ;
    }
    pin (Z) {
      direction : output ;
      max_capacitance : 0.08 ;
      function : "(I0&!S)|(I1&S)" ;
      timing () {
        related_pin : "I0" ;
        timing_sense : non_unate ;
        cell_rise (delay_2x2) {
          values ("0.021, 0.034", \
                  "0.029, 0.041") ;
        }
        cell_fall (delay_2x2) {
          values ("0.019, 0.031", \
                  "0.027, 0.038") ;
        }
      }
      timing () {
        related_pin : "I1" ;
        timing_sense : non_unate ;
        cell_rise (delay_2x2) {
          values ("0.021, 0.034", \
                  "0.029, 0.041") ;
        }
        cell_fall (delay_2x2) {
          values ("0.019, 0.031", \
                  "0.027, 0.038") ;
